@page "/orders"
@page "/kitchen"
@page "/help"
@page "/terms"
@page "/privacy"
@page "/forgot-password"
@page "/coming-soon"
@inject NavigationManager Nav

<div class="min-h-screen bg-[#FAF7F2] text-[#26201A] flex flex-col justify-between selection:bg-[#B84A2B] selection:text-white">

    <!-- TOP NAVIGATION -->
    <header class="bg-[#FAF7F2] border-b border-[#EADFD4]/80 sticky top-0 z-30 backdrop-blur-md bg-opacity-90">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo (Routes to /login) -->
            <a href="/login" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-full bg-[#F3E5D8] text-[#B84A2B] flex items-center justify-center transition-transform group-hover:scale-105">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M12.5 2c-.3 0-.6.2-.7.4L9.4 6.7c-.4.7-.1 1.6.6 2 .7.4 1.6.1 2-.6l1.7-3.1 1.7 3.1c.4.7 1.3 1 2 .6.7-.4 1-1.3.6-2l-2.4-4.3c-.2-.3-.5-.4-.7-.4h-1.8zm-4.7 6.3c-.2.2-.3.5-.3.8 0 .8.6 1.4 1.4 1.4h4.2l-3.9 3.9c-.6.6-.6 1.5 0 2.1.6.6 1.5.6 2.1 0l3.9-3.9v4.2c0 .8.6 1.4 1.4 1.4.8 0 1.4-.6 1.4-1.4v-4.2l3.9 3.9c.6.6 1.5.6 2.1 0 .6-.6.6-1.5 0-2.1l-3.9-3.9h4.2c.8 0 1.4-.6 1.4-1.4 0-.3-.1-.6-.3-.8l-3.4-3.4c-.4-.4-1-.5-1.5-.3l-3.7 1.9-3.7-1.9c-.5-.2-1.1-.1-1.5.3L7.8 8.3z"/>
                    </svg>
                </div>
                <div>
                    <span class="font-serif text-lg tracking-wide font-medium text-[#231B15] block leading-tight">Empanada Empire</span>
                    <span class="text-[9px] uppercase tracking-widest text-[#8A7B70] font-bold block">Baked with a little extra love</span>
                </div>
            </a>

            <!-- Quick back to login link -->
            <a href="/login" class="group flex items-center space-x-2 text-xs font-semibold text-[#B84A2B] hover:text-[#9A381C] transition-colors">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Back to log in</span>
            </a>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="max-w-2xl mx-auto px-4 sm:px-6 py-16 sm:py-24 flex-1 flex flex-col items-center justify-center text-center">
        
        <!-- Status Pill -->
        <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-[#EBF2EA] border border-[#D7E4D5] text-[#2D452B] text-xs font-semibold uppercase tracking-wider mb-6">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Still baking in our oven</span>
        </div>

        <!-- Decorative Oven/Pastry Icon -->
        <div class="w-20 h-20 rounded-3xl bg-[#F4ECE3] border border-[#E9DFD5] flex items-center justify-center text-[#B84A2B] mb-6 shadow-sm">
            <svg class="w-10 h-10" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24">
                <rect x="2" y="4" width="20" height="16" rx="3" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 8h12M6 12h12M9 16h6" />
                <circle cx="18" cy="8" r="0.5" fill="currentColor" />
            </svg>
        </div>

        <!-- Headline & Dynamic Route Title -->
        <h1 class="font-serif text-3xl sm:text-5xl text-[#231B15] font-normal mb-3">
            @PageTitle
        </h1>
        
        <p class="text-sm sm:text-base text-[#6C5E53] max-w-md leading-relaxed mb-8">
            We're perfecting this corner of the bakery. Please log in or create an account to start your order.
        </p>

        <!-- Action CTAs (Safe routes: /login and /register) -->
        <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">
            <a href="/login"
               class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-[#B84A2B] hover:bg-[#A13E22] active:bg-[#8D351C] text-white text-xs font-semibold tracking-wide transition shadow-md flex items-center justify-center space-x-2">
                <span>Return to log in</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
            </a>

            <a href="/register"
               class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-white hover:bg-[#F5EDE4] border border-[#E4D7CC] text-[#42342A] text-xs font-semibold tracking-wide transition shadow-sm flex items-center justify-center">
                Create an account
            </a>
        </div>

        <!-- Footnote -->
        <div class="mt-12 pt-6 border-t border-[#EFE5DB] max-w-sm text-xs text-[#8A7B70]">
            <p>Need immediate assistance? Reach out to our Cebu City bakery team.</p>
        </div>
    </main>

    <!-- FOOTER -->
    <footer class="border-t border-[#E8DCD1] bg-[#FAF7F2] py-8 text-xs text-[#8A7B70]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>© 2026 Empanada Empire. Made with love in Cebu.</p>
            <div class="flex items-center space-x-6">
                <a href="/help" class="hover:text-[#B84A2B] transition-colors">Need a hand?</a>
                <a href="/privacy" class="hover:text-[#B84A2B] transition-colors">Privacy policy</a>
                <a href="/terms" class="hover:text-[#B84A2B] transition-colors">Terms of service</a>
            </div>
        </div>
    </footer>
</div>

@code {
    private string PageTitle => Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant() switch
    {
        "orders" => "My orders is in the works.",
        "kitchen" => "Our kitchen story is brewing.",
        "help" => "Help center coming soon.",
        "terms" => "Terms of service.",
        "privacy" => "Privacy policy.",
        "forgot-password" => "Password recovery is on the way.",
        _ => "Something golden is coming."
    };
}