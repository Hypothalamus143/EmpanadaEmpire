@page "/register"
@rendermode InteractiveServer
@using EmpanadaEmpire.Models.Auth
@inject NavigationManager Nav

<div class="min-h-screen bg-[#FAF7F2] text-[#26201A] py-10 px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto">
        
        <!-- Top Nav -->
        <header class="flex items-center justify-between text-xs tracking-wide text-[#7C6E65] mb-8">
            <a href="/login" class="group flex items-center space-x-2 hover:text-[#B84A2B] transition-colors font-medium">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Back to log in</span>
            </a>

            <a href="/help" class="hover:text-[#B84A2B] transition-colors">
                Need help?
            </a>
        </header>

        <!-- Page Header -->
        <div class="mb-10">
            <span class="text-[11px] font-bold tracking-widest uppercase text-[#B84A2B] block mb-2">
                There's a seat at our table
            </span>
            <h1 class="text-3xl sm:text-4xl font-serif text-[#231B15] font-normal mb-3">
                Join the empire.
            </h1>
            <p class="text-sm text-[#6C5E53] leading-relaxed">
                A few details, then you're one step closer to your first warm bite.
            </p>
        </div>

        <EditForm Model="@registerModel" OnValidSubmit="HandleRegister" FormName="register-form">
            <DataAnnotationsValidator />

            <!-- SECTION 1: Personal & Account Details -->
            <section class="mb-10">
                <div class="flex items-center space-x-3 mb-6">
                    <div class="w-6 h-6 rounded-full bg-[#F3E5D8] text-[#B84A2B] font-bold text-xs flex items-center justify-center">
                        1
                    </div>
                    <h2 class="text-base font-bold text-[#231B15]">
                        A little about you
                    </h2>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- First Name -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="firstName">
                            First name *
                        </label>
                        <InputText id="firstName" 
                                   @bind-Value="registerModel.FirstName" 
                                   placeholder="Maria"
                                   class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        <ValidationMessage For="@(() => registerModel.FirstName)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Last Name -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="lastName">
                            Last name *
                        </label>
                        <InputText id="lastName" 
                                   @bind-Value="registerModel.LastName" 
                                   placeholder="Santos"
                                   class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        <ValidationMessage For="@(() => registerModel.LastName)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Email Address -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="email">
                            Email address *
                        </label>
                        <InputText id="email" 
                                   @bind-Value="registerModel.Email" 
                                   placeholder="maria.santos@email.com"
                                   class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        <ValidationMessage For="@(() => registerModel.Email)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Mobile Number -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="mobile">
                            Mobile number *
                        </label>
                        <InputText id="mobile" 
                                   @bind-Value="registerModel.MobileNumber" 
                                   placeholder="+63 917 123 4567"
                                   class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        <ValidationMessage For="@(() => registerModel.MobileNumber)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Password -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="password">
                            Password *
                        </label>
                        <div class="relative">
                            <input id="password" 
                                   type="@(showPassword ? "text" : "password")" 
                                   @bind="registerModel.Password" 
                                   class="w-full px-4 py-3 pr-11 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                            
                            <button type="button" 
                                    @onclick="() => showPassword = !showPassword"
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#998A7F] hover:text-[#3C322A] focus:outline-none"
                                    aria-label="Toggle password visibility">
                                @if (showPassword)
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.Password)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Confirm Password -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="confirmPassword">
                            Confirm password *
                        </label>
                        <div class="relative">
                            <input id="confirmPassword" 
                                   type="@(showConfirmPassword ? "text" : "password")" 
                                   @bind="registerModel.ConfirmPassword" 
                                   class="w-full px-4 py-3 pr-11 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                            
                            <button type="button" 
                                    @onclick="() => showConfirmPassword = !showConfirmPassword"
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#998A7F] hover:text-[#3C322A] focus:outline-none"
                                    aria-label="Toggle confirm password visibility">
                                @if (showConfirmPassword)
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => registerModel.ConfirmPassword)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>
                </div>

                <p class="text-[11px] text-[#7C6E65] mt-2.5">
                    Use at least 8 characters, including a number.
                </p>
            </section>

            <!-- SECTION 2: Delivery Address -->
            <section class="mb-8">
                <div class="flex items-center space-x-3 mb-4">
                    <div class="w-6 h-6 rounded-full bg-[#F3E5D8] text-[#B84A2B] font-bold text-xs flex items-center justify-center">
                        2
                    </div>
                    <h2 class="text-base font-bold text-[#231B15]">
                        Where should we bring the good stuff?
                    </h2>
                </div>

                <!-- Cebu City Service Banner -->
                <div class="flex items-center space-x-2.5 p-3.5 mb-5 rounded-xl bg-[#EBF2EA] border border-[#D7E4D5] text-[#2D452B] text-xs">
                    <svg class="w-4 h-4 text-[#2E582A] flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 00-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 00-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
                    </svg>
                    <span>For now, our ovens serve Cebu City, Philippines only.</span>
                </div>

                <div class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Locked Country -->
                        <div>
                            <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="country">
                                Country *
                            </label>
                            <div class="relative">
                                <input id="country" 
                                       type="text" 
                                       readonly 
                                       value="@registerModel.Country" 
                                       class="w-full px-4 py-3 pr-10 rounded-xl bg-[#F0EBE4] border border-[#DDD3C7] text-sm text-[#4E433B] cursor-not-allowed select-none focus:outline-none" />
                                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[#8A7C72]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>

                        <!-- Locked City -->
                        <div>
                            <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="city">
                                City *
                            </label>
                            <div class="relative">
                                <input id="city" 
                                       type="text" 
                                       readonly 
                                       value="@registerModel.City" 
                                       class="w-full px-4 py-3 pr-10 rounded-xl bg-[#F0EBE4] border border-[#DDD3C7] text-sm text-[#4E433B] cursor-not-allowed select-none focus:outline-none" />
                                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[#8A7C72]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                                        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                    </svg>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <!-- Barangay Dropdown -->
                        <div>
                            <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="barangay">
                                Barangay *
                            </label>
                            <div class="relative">
                                <InputSelect id="barangay" 
                                             @bind-Value="registerModel.Barangay" 
                                             class="w-full appearance-none px-4 py-3 pr-10 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm">
                                    <option value="">Select barangay...</option>
                                    @foreach (var brgy in CebuBarangays)
                                    {
                                        <option value="@brgy">@brgy</option>
                                    }
                                </InputSelect>
                                <div class="absolute inset-y-0 right-0 pr-3.5 flex items-center pointer-events-none text-[#8A7C72]">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                                    </svg>
                                </div>
                            </div>
                            <ValidationMessage For="@(() => registerModel.Barangay)" class="text-xs text-red-600 mt-1 font-medium" />
                        </div>

                        <!-- Landmark -->
                        <div>
                            <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="landmark">
                                Landmark (optional)
                            </label>
                            <InputText id="landmark" 
                                       @bind-Value="registerModel.Landmark" 
                                       placeholder="Near JY Square Mall" 
                                       class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        </div>
                    </div>

                    <!-- House / Street Address -->
                    <div>
                        <label class="block text-xs font-semibold text-[#3C322A] mb-1.5" for="streetAddress">
                            House / unit number, building & street *
                        </label>
                        <InputText id="streetAddress" 
                                   @bind-Value="registerModel.StreetAddress" 
                                   placeholder="Unit 3B, 24 Salinas Drive" 
                                   class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        <ValidationMessage For="@(() => registerModel.StreetAddress)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>
                </div>
            </section>

            <!-- Terms & Conditions Checkbox -->
            <div class="mb-6">
                <label class="inline-flex items-start space-x-2.5 text-xs text-[#5F5247] cursor-pointer select-none">
                    <InputCheckbox @bind-Value="registerModel.AgreeToTerms" 
                                   class="mt-0.5 w-4 h-4 rounded border-[#D2C3B5] text-[#B84A2B] focus:ring-[#B84A2B] focus:ring-offset-0 transition" />
                    <span>
                        I agree to the 
                        <a href="/terms" class="underline hover:text-[#B84A2B]">Terms of service</a> 
                        and 
                        <a href="/privacy" class="underline hover:text-[#B84A2B]">Privacy policy</a>.
                    </span>
                </label>
                <ValidationMessage For="@(() => registerModel.AgreeToTerms)" class="text-xs text-red-600 mt-1 font-medium block" />
            </div>

            <!-- Submit Button -->
            <button type="submit" 
                    disabled="@isLoading"
                    class="group relative w-full flex items-center justify-center space-x-2 py-3.5 px-6 rounded-xl bg-[#B84A2B] hover:bg-[#A13E22] active:bg-[#8D351C] text-white font-medium text-sm transition-all shadow-md hover:shadow-lg disabled:opacity-75 disabled:cursor-not-allowed">
                @if (isLoading)
                {
                    <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                    <span>Setting your place at the table...</span>
                }
                else
                {
                    <span>Create my account</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                }
            </button>
        </EditForm>

        <!-- Login Redirect Link -->
        <div class="mt-8 text-center text-xs text-[#6F6156]">
            Already part of the family? 
            <a href="/login" class="font-semibold text-[#B84A2B] hover:text-[#9A381C] transition-colors ml-1">
                Log in
            </a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private RegisterModel registerModel { get; set; } = new()
    {
        Country = "Philippines",
        City = "Cebu City",
        Barangay = "Lahug",
        FirstName = "Maria",
        LastName = "Santos",
        Email = "maria.santos@email.com",
        MobileNumber = "+639171234567",
        StreetAddress = "Unit 3B, 24 Salinas Drive",
        Landmark = "Near JY Square Mall",
        AgreeToTerms = true
    };

    private bool showPassword = false;
    private bool showConfirmPassword = false;
    private bool isLoading = false;

    // Common Cebu City barangays for dropdown
    private readonly List<string> CebuBarangays = new()
    {
        "Apas",
        "Banilad",
        "Busay",
        "Capitol Site",
        "Guadalupe",
        "Kasambagan",
        "Lahug",
        "Luz",
        "Mabolo",
        "Punta Princesa",
        "Talamban",
        "Zapatera"
    };

    private async Task HandleRegister()
    {
        isLoading = true;

        // Simulate user creation API call
        await Task.Delay(1200);

        isLoading = false;

        // Navigate to menu on success
        Nav.NavigateTo("/menu");
    }
}