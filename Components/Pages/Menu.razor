@page "/menu"
@rendermode InteractiveServer
@using EmpanadaEmpire.Models.Catalog
@using EmpanadaEmpire.Models.Cart
@using EmpanadaEmpire.Models.Enums
@inject NavigationManager Nav

<div class="min-h-screen bg-[#FAF7F2] text-[#26201A] flex flex-col justify-between selection:bg-[#B84A2B] selection:text-white pb-28">

    <!-- TOP NAVIGATION -->
    <header class="bg-[#FAF7F2] border-b border-[#EADFD4]/80 sticky top-0 z-30 backdrop-blur-md bg-opacity-90">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            
            <!-- Brand Logo -->
            <a href="/menu" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-full bg-[#F3E5D8] text-[#B84A2B] flex items-center justify-center transition-transform group-hover:scale-105">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                        <path d="M12.5 2c-.3 0-.6.2-.7.4L9.4 6.7c-.4.7-.1 1.6.6 2 .7.4 1.6.1 2-.6l1.7-3.1 1.7 3.1c.4.7 1.3 1 2 .6.7-.4 1-1.3.6-2l-2.4-4.3c-.2-.3-.5-.4-.7-.4h-1.8zm-4.7 6.3c-.2.2-.3.5-.3.8 0 .8.6 1.4 1.4 1.4h4.2l-3.9 3.9c-.6.6-.6 1.5 0 2.1.6.6 1.5.6 2.1 0l3.9-3.9v4.2c0 .8.6 1.4 1.4 1.4.8 0 1.4-.6 1.4-1.4v-4.2l3.9 3.9c.6.6 1.5.6 2.1 0 .6-.6.6-1.5 0-2.1l-3.9-3.9h4.2c.8 0 1.4-.6 1.4-1.4 0-.3-.1-.6-.3-.8l-3.4-3.4c-.4-.4-1-.5-1.5-.3l-3.7 1.9-3.7-1.9c-.5-.2-1.1-.1-1.5.3L7.8 8.3z"/>
                    </svg>
                </div>
                <div>
                    <span class="font-serif text-lg tracking-wide font-medium text-[#231B15] block leading-tight">Empanada Empire</span>
                    <span class="text-[9px] uppercase tracking-widest text-[#8A7B70] font-bold block">Baked with a little extra love</span>
                </div>
            </a>

            <!-- Center Nav Links -->
            <nav class="hidden md:flex items-center space-x-8 text-xs font-semibold tracking-wide">
                <a href="/menu" class="text-[#231B15] border-b-2 border-[#B84A2B] pb-1">Our menu</a>
                <a href="/orders" class="text-[#7C6E65] hover:text-[#B84A2B] transition-colors pb-1">My orders</a>
                <a href="/kitchen" class="text-[#7C6E65] hover:text-[#B84A2B] transition-colors pb-1">Our kitchen</a>
            </nav>

            <!-- Right Controls: Cart & Profile -->
            <div class="flex items-center space-x-4">
                <button @onclick="NavigateToCart" class="flex items-center space-x-2 px-3.5 py-2 rounded-full bg-[#F5ECE2] hover:bg-[#EBDFD3] text-[#231B15] text-xs font-semibold transition shadow-sm">
                    <svg class="w-4 h-4 text-[#B84A2B]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    <span>Cart · @cart.TotalPieces</span>
                </button>

                <div class="w-9 h-9 rounded-full bg-[#E8DDD2] text-[#55463D] flex items-center justify-center font-bold text-xs ring-2 ring-white">
                    MS
                </div>
            </div>
        </div>

        <!-- Sub-header Bar: Delivery destination & Store hours -->
        <div class="bg-[#F4ECE3]/60 border-t border-[#EADFD4]">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between text-xs text-[#6F6055]">
                <button class="flex items-center space-x-1.5 hover:text-[#B84A2B] transition-colors font-medium">
                    <svg class="w-3.5 h-3.5 text-[#B84A2B]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 00-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 00-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
                    </svg>
                    <span>Deliver to <strong>Maria</strong> · Lahug, Cebu City</span>
                    <svg class="w-3 h-3 ml-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                </button>

                <div class="flex items-center space-x-2 font-medium">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>Ovens on · Open daily, 8 AM–7 PM</span>
                </div>
            </div>
        </div>
    </header>

    <!-- MAIN BODY -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 w-full flex-1 space-y-10">
        
        <!-- GREETING & SEARCH -->
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h1 class="font-serif text-3xl sm:text-4xl text-[#231B15] font-normal">
                    Maayong adlaw, Maria!
                </h1>
                <p class="text-sm text-[#77685D] mt-1">
                    What's your pocket of happiness today?
                </p>
            </div>

            <!-- Search Bar -->
            <div class="relative w-full md:w-80">
                <input type="text" 
                       @bind="searchQuery" 
                       @bind:event="oninput"
                       placeholder="Find your favorite filling..."
                       class="w-full pl-10 pr-4 py-2.5 rounded-full bg-white border border-[#E4D7CC] text-xs text-[#26201A] placeholder-[#A4968C] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] shadow-sm transition" />
                <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-[#A4968C]">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="M21 21l-4.35-4.35"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- HERO BANNER -->
        <div class="relative rounded-3xl bg-[#F0E4D5] overflow-hidden border border-[#E5D7C7] shadow-sm">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-center">
                <div class="p-8 sm:p-10 lg:col-span-7 space-y-4">
                    <span class="text-[10px] font-bold tracking-widest uppercase text-[#B84A2B] block">
                        Small batches. Big comfort.
                    </span>
                    <h2 class="font-serif text-3xl sm:text-5xl text-[#231B15] font-light leading-tight">
                        Your merienda,<br />
                        <span class="font-normal">made golden.</span>
                    </h2>
                    <p class="text-xs sm:text-sm text-[#6C5E53] max-w-md">
                        Hand-folded Filipino favorites, baked fresh every day.
                    </p>

                    <!-- Info badges -->
                    <div class="pt-3 flex flex-wrap items-center gap-3 text-xs text-[#4F4137]">
                        <span class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-full bg-white/70 backdrop-blur-sm border border-[#DFCFC2] font-medium">
                            <svg class="w-3.5 h-3.5 text-[#B84A2B]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                <circle cx="12" cy="12" r="10" />
                                <polyline points="12 6 12 12 16 14" />
                            </svg>
                            <span>At your door in 30–45 min</span>
                        </span>
                        <span class="inline-flex items-center px-3 py-1.5 rounded-full bg-white/70 backdrop-blur-sm border border-[#DFCFC2] font-medium">
                            Made right here in Cebu
                        </span>
                    </div>
                </div>

                <!-- Banner Image -->
                <div class="lg:col-span-5 h-64 lg:h-full relative min-h-[260px]">
                    <img src="images/meriendaspread.png" 
                         alt="Empanadas basket on table" 
                         class="absolute inset-0 w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-gradient-to-t lg:bg-gradient-to-r from-[#F0E4D5] via-transparent to-transparent"></div>
                </div>
            </div>
        </div>

        <!-- MENU CATALOG SECTION -->
        <div class="space-y-6">
            
            <!-- Section Header & Filter Tabs -->
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div>
                    <h2 class="font-serif text-2xl text-[#231B15]">Fresh from the oven</h2>
                </div>
                <div class="text-xs text-[#8A7B70] font-medium">
                    @FilteredProducts.Count() delicious reasons to take a break
                </div>
            </div>

            <!-- Categories Filter -->
            <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none">
                <button @onclick="() => selectedCategory = ProductCategory.All"
                        class="px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap @(selectedCategory == ProductCategory.All ? "bg-[#8E3B20] text-white shadow-sm" : "bg-white border border-[#E6DACF] text-[#63544A] hover:bg-[#F5EDE4]")">
                    All empanadas
                </button>
                <button @onclick="() => selectedCategory = ProductCategory.SavoryFavorites"
                        class="px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap @(selectedCategory == ProductCategory.SavoryFavorites ? "bg-[#8E3B20] text-white shadow-sm" : "bg-white border border-[#E6DACF] text-[#63544A] hover:bg-[#F5EDE4]")">
                    Savory favorites
                </button>
                <button @onclick="() => selectedCategory = ProductCategory.SweetTreats"
                        class="px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap @(selectedCategory == ProductCategory.SweetTreats ? "bg-[#8E3B20] text-white shadow-sm" : "bg-white border border-[#E6DACF] text-[#63544A] hover:bg-[#F5EDE4]")">
                    Sweet treats
                </button>
                <button @onclick="() => selectedCategory = ProductCategory.Vegetarian"
                        class="px-4 py-2 rounded-full text-xs font-semibold transition whitespace-nowrap @(selectedCategory == ProductCategory.Vegetarian ? "bg-[#8E3B20] text-white shadow-sm" : "bg-white border border-[#E6DACF] text-[#63544A] hover:bg-[#F5EDE4]")">
                    Vegetarian
                </button>
            </div>

            <!-- Product Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                @foreach (var product in FilteredProducts)
                {
                    var quantityInBag = GetQuantityInBag(product.Id);

                    <div class="bg-white rounded-2xl border border-[#E9DFD5] overflow-hidden shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
                        <div>
                            <!-- Card Image with Tag -->
                            <div class="relative h-44 w-full bg-[#F3EDE6] overflow-hidden">
                                <img src="@product.ImageUrl" 
                                     alt="@product.Name" 
                                     class="w-full h-full object-cover transition-transform duration-500 hover:scale-105" />
                                
                                @if (product.Badge != ProductBadge.None)
                                {
                                    <div class="absolute top-3 left-3">
                                        <span class="text-[9px] font-bold tracking-wider uppercase px-2 py-1 rounded bg-white/90 backdrop-blur-md shadow-sm @GetBadgeClass(product.Badge)">
                                            @GetBadgeLabel(product.Badge)
                                        </span>
                                    </div>
                                }
                            </div>

                            <!-- Card Body -->
                            <div class="p-5">
                                <h3 class="font-serif text-lg font-medium text-[#231B15]">
                                    @product.Name
                                </h3>
                                <p class="text-xs text-[#7A6B61] mt-1 line-clamp-2 leading-relaxed">
                                    @product.Description
                                </p>
                            </div>
                        </div>

                        <!-- Card Footer -->
                        <div class="px-5 pb-5 pt-1 flex items-center justify-between border-t border-transparent">
                            <div class="text-sm font-semibold text-[#231B15]">
                                ₱@product.Price.ToString("N0") <span class="text-xs font-normal text-[#8A7B70]">/ piece</span>
                            </div>

                            <!-- Quantity Counter or Add Button -->
                            @if (quantityInBag > 0)
                            {
                                <div class="flex items-center space-x-2.5 bg-[#FAF7F2] border border-[#E4D7CC] rounded-xl px-2 py-1">
                                    <button @onclick="() => DecrementCart(product.Id)" 
                                            class="w-6 h-6 flex items-center justify-center text-[#7A6B61] hover:text-[#B84A2B] font-bold transition">
                                        –
                                    </button>
                                    <span class="text-xs font-bold text-[#231B15] w-4 text-center">@quantityInBag</span>
                                    <button @onclick="() => IncrementCart(product)" 
                                            class="w-6 h-6 flex items-center justify-center text-[#7A6B61] hover:text-[#B84A2B] font-bold transition">
                                        +
                                    </button>
                                </div>
                            }
                            else
                            {
                                <button @onclick="() => IncrementCart(product)"
                                        class="px-4 py-2 rounded-xl bg-[#B84A2B] hover:bg-[#A13E22] active:bg-[#8D351C] text-white text-xs font-semibold transition flex items-center space-x-1 shadow-sm">
                                    <span>+ Add to cart</span>
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </main>

    <!-- STICKY FLOATING CART BAR (If cart has items) -->
    @if (cart.TotalPieces > 0)
    {
        <div class="fixed bottom-4 inset-x-0 z-40 max-w-4xl mx-auto px-4">
            <div class="bg-[#2B231E] rounded-2xl p-4 sm:py-3.5 sm:px-6 shadow-2xl flex items-center justify-between text-white border border-white/10">
                <div class="flex items-center space-x-3.5">
                    <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-[#E5A885]">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                    </div>
                    <div>
                        <p class="text-xs sm:text-sm font-semibold tracking-wide">
                            @cart.TotalPieces golden pockets in your bag
                        </p>
                        <p class="text-[11px] text-[#A6998E] hidden sm:block">
                            A little savory, a little sweet. A whole lot to love.
                        </p>
                    </div>
                </div>

                <button @onclick="NavigateToCart"
                        class="group flex items-center space-x-2 bg-[#B84A2B] hover:bg-[#A13E22] active:bg-[#8D351C] px-5 py-2.5 rounded-xl text-xs font-semibold tracking-wide transition shadow-md">
                    <span>View cart · @cart.FormattedSubtotal</span>
                    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                    </svg>
                </button>
            </div>
        </div>
    }

    <!-- FOOTER -->
    <footer class="border-t border-[#E8DCD1] bg-[#FAF7F2] py-8 text-xs text-[#8A7B70]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
            <p>© 2026 Empanada Empire. Made with love in Cebu.</p>
            <div class="flex items-center space-x-6">
                <a href="/help" class="hover:text-[#B84A2B] transition-colors">Need a hand?</a>
                <a href="/privacy" class="hover:text-[#B84A2B] transition-colors">Privacy policy</a>
                <a href="/terms" class="hover:text-[#B84A2B] transition-colors">Terms of service</a>
            </div>
        </div>
    </footer>
</div>

@code {
    private ProductCategory selectedCategory = ProductCategory.All;
    private string searchQuery = string.Empty;

    // Seeded cart with initial values matching Image 1 & 4 (6 items total)
    private ShoppingCart cart = new();

    private List<Product> products = new();

    protected override void OnInitialized()
    {
        // Populate products matching the UI mockups
        products = new List<Product>
        {
            new() 
            { 
                Id = Guid.Parse("11111111-1111-1111-1111-111111111111"),
                Name = "Classic Chicken", 
                Description = "Tender chicken, potato & carrot. The original comfort bite.", 
                Price = 65, 
                Badge = ProductBadge.Bestseller, 
                Category = ProductCategory.SavoryFavorites,
                ImageUrl = "images/classicchicken.png" 
            },
            new() 
            { 
                Id = Guid.Parse("22222222-2222-2222-2222-222222222222"),
                Name = "Savory Beef", 
                Description = "Rich seasoned beef, sweet raisins & a little nostalgia.", 
                Price = 75, 
                Badge = ProductBadge.CrowdFavorite, 
                Category = ProductCategory.SavoryFavorites,
                ImageUrl = "images/savorybeef.png" 
            },
            new() 
            { 
                Id = Guid.Parse("33333333-3333-3333-3333-333333333333"),
                Name = "Three-Cheese", 
                Description = "Cheddar, mozzarella & cream cheese. Melty goodness.", 
                Price = 55, 
                Badge = ProductBadge.Vegetarian, 
                Category = ProductCategory.Vegetarian,
                ImageUrl = "images/threecheese.png" 
            },
            new() 
            { 
                Id = Guid.Parse("44444444-4444-4444-4444-444444444444"),
                Name = "Ube & Cheese", 
                Description = "Creamy ube halaya meets a savory cheese center.", 
                Price = 60, 
                Badge = ProductBadge.SweetFavorite, 
                Category = ProductCategory.SweetTreats,
                ImageUrl = "images/ubecheese.png" 
            },
            new() 
            { 
                Id = Guid.Parse("55555555-5555-5555-5555-555555555555"),
                Name = "Spicy Tuna", 
                Description = "Flaked tuna, bell peppers & just the right kick.", 
                Price = 70, 
                Badge = ProductBadge.ALittleHeat, 
                Category = ProductCategory.SavoryFavorites,
                ImageUrl = "images/spicytuna.png" 
            },
            new() 
            { 
                Id = Guid.Parse("66666666-6666-6666-6666-666666666666"),
                Name = "Garlic Mushroom", 
                Description = "Sautéed mushrooms, roasted garlic & herbs.", 
                Price = 65, 
                Badge = ProductBadge.Vegetarian, 
                Category = ProductCategory.Vegetarian,
                ImageUrl = "images/garlicmushroom.png" 
            }
        };

        // Seed with items currently present in the cart from Image 1 & 4
        cart.AddOrIncrement(CartItem.FromProduct(products[0], 2)); // 2 Classic Chicken
        cart.AddOrIncrement(CartItem.FromProduct(products[1], 2)); // 2 Savory Beef
        cart.AddOrIncrement(CartItem.FromProduct(products[2], 1)); // 1 Three Cheese
        cart.AddOrIncrement(CartItem.FromProduct(products[3], 1)); // 1 Ube & Cheese
    }

    private IEnumerable<Product> FilteredProducts =>
        products
            .Where(p => selectedCategory == ProductCategory.All || p.Category == selectedCategory)
            .Where(p => string.IsNullOrWhiteSpace(searchQuery) || 
                        p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
                        p.Description.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private int GetQuantityInBag(Guid productId) =>
        cart.Items.FirstOrDefault(i => i.ProductId == productId)?.Quantity ?? 0;

    private void IncrementCart(Product product)
    {
        cart.AddOrIncrement(CartItem.FromProduct(product, 1));
    }

    private void DecrementCart(Guid productId)
    {
        cart.DecrementOrRemove(productId);
    }

    private void NavigateToCart()
    {
        Nav.NavigateTo("/cart");
    }

    private string GetBadgeLabel(ProductBadge badge) => badge switch
    {
        ProductBadge.Bestseller => "BESTSELLER",
        ProductBadge.CrowdFavorite => "CROWD FAVORITE",
        ProductBadge.Vegetarian => "VEGETARIAN",
        ProductBadge.SweetFavorite => "SWEET FAVORITE",
        ProductBadge.ALittleHeat => "A LITTLE HEAT",
        _ => string.Empty
    };

    private string GetBadgeClass(ProductBadge badge) => badge switch
    {
        ProductBadge.Bestseller => "text-amber-800",
        ProductBadge.CrowdFavorite => "text-amber-900",
        ProductBadge.Vegetarian => "text-emerald-800",
        ProductBadge.SweetFavorite => "text-purple-800",
        ProductBadge.ALittleHeat => "text-rose-700",
        _ => "text-stone-700"
    };
}