@page "/"
@page "/login"
@rendermode InteractiveServer
@using EmpanadaEmpire.Models.Auth
@inject NavigationManager Nav

<div class="min-h-screen flex flex-col lg:flex-row bg-[#FAF7F2] text-[#26201A]">
    
    <!-- LEFT PANEL: Hero Banner (Desktop Only) -->
    <div class="relative hidden lg:flex lg:w-1/2 min-h-screen flex-col justify-between p-12 xl:p-16 overflow-hidden bg-[#1E1713]">
        <!-- Background Food Image with Warm Gradient Overlay -->
        <img src="images/freshempanadas.png" 
             alt="Fresh baked golden empanadas" 
             class="absolute inset-0 w-full h-full object-cover object-center opacity-45 mix-blend-luminosity scale-105 transform hover:scale-100 transition-transform duration-1000" />
        <div class="absolute inset-0 bg-gradient-to-t from-[#140E0A] via-[#1A120D]/60 to-transparent"></div>

        <!-- Top Left: Bakery Brand Badge -->
        <div class="relative z-10 flex items-center space-x-3.5">
            <div class="w-10 h-10 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-amber-200">
                <!-- Wheat / Bread SVG -->
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                    <path d="M12.5 2c-.3 0-.6.2-.7.4L9.4 6.7c-.4.7-.1 1.6.6 2 .7.4 1.6.1 2-.6l1.7-3.1 1.7 3.1c.4.7 1.3 1 2 .6.7-.4 1-1.3.6-2l-2.4-4.3c-.2-.3-.5-.4-.7-.4h-1.8zm-4.7 6.3c-.2.2-.3.5-.3.8 0 .8.6 1.4 1.4 1.4h4.2l-3.9 3.9c-.6.6-.6 1.5 0 2.1.6.6 1.5.6 2.1 0l3.9-3.9v4.2c0 .8.6 1.4 1.4 1.4.8 0 1.4-.6 1.4-1.4v-4.2l3.9 3.9c.6.6 1.5.6 2.1 0 .6-.6.6-1.5 0-2.1l-3.9-3.9h4.2c.8 0 1.4-.6 1.4-1.4 0-.3-.1-.6-.3-.8l-3.4-3.4c-.4-.4-1-.5-1.5-.3l-3.7 1.9-3.7-1.9c-.5-.2-1.1-.1-1.5.3L7.8 8.3z"/>
                </svg>
            </div>
            <div>
                <h1 class="text-white font-serif text-lg tracking-wide font-medium">Empanada Empire</h1>
                <p class="text-[10px] uppercase tracking-widest text-[#D4C3B3] font-semibold">Baked with a little extra love</p>
            </div>
        </div>

        <!-- Bottom Left: Tagline & Proof Points -->
        <div class="relative z-10 space-y-6 max-w-lg">
            <div class="inline-flex items-center space-x-2 text-xs uppercase tracking-widest font-semibold text-amber-200/90 bg-black/30 backdrop-blur-sm px-3 py-1.5 rounded-full border border-white/10">
                <svg class="w-3.5 h-3.5 text-amber-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 2a8 8 0 00-8 8c0 5.25 8 12 8 12s8-6.75 8-12a8 8 0 00-8-8zm0 11a3 3 0 110-6 3 3 0 010 6z" />
                </svg>
                <span>Proudly baked in Cebu</span>
            </div>

            <h2 class="font-serif text-4xl xl:text-5xl text-white leading-[1.15] font-light">
                A little pocket.<br />
                A whole lot<br />
                <span class="italic font-normal">of happiness.</span>
            </h2>

            <p class="text-[#D8C7B8] text-sm md:text-base leading-relaxed">
                Golden, flaky, and filled with Filipino favorites. Fresh from our oven, straight to your doorstep.
            </p>

            <div class="pt-4 flex items-center space-x-8 text-[11px] uppercase tracking-widest text-amber-100/70 border-t border-white/10 font-semibold">
                <span>Hand-folded daily</span>
                <span class="inline-block w-1 h-1 rounded-full bg-amber-200/40"></span>
                <span>Never short on filling</span>
            </div>
        </div>
    </div>

    <!-- RIGHT PANEL: Login Form -->
    <div class="w-full lg:w-1/2 min-h-screen flex flex-col justify-between p-6 sm:p-12 xl:p-16 bg-[#FAF7F2]">
        
        <!-- Top Nav -->
        <header class="flex items-center justify-between text-xs tracking-wide text-[#7C6E65]">
            <a href="/coming-soon" class="group flex items-center space-x-2 hover:text-[#B84A2B] transition-colors font-medium">
                <svg class="w-4 h-4 transition-transform group-hover:-translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                </svg>
                <span>Back to the bakery</span>
            </a>

            <a href="/help" class="hover:text-[#B84A2B] transition-colors">
                Need help?
            </a>
        </header>

        <!-- Form Container -->
        <main class="w-full max-w-md mx-auto my-auto py-10">
            <!-- Header section -->
            <div class="mb-8">
                <span class="text-[11px] font-bold tracking-widest uppercase text-[#B84A2B] block mb-2">
                    Your daily dose of golden
                </span>
                <h2 class="text-3xl sm:text-4xl font-serif text-[#231B15] font-normal mb-3">
                    Welcome back.
                </h2>
                <p class="text-sm text-[#6C5E53] leading-relaxed">
                    Your favorites are fresh out of the oven. Log in and let's get something delicious started.
                </p>
            </div>

            <!-- EditForm -->
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="login-form">
                <DataAnnotationsValidator />

                <div class="space-y-5">
                    <!-- Email field -->
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-[#3C322A] mb-2" for="email">
                            Email address
                        </label>
                        <div class="relative">
                            <InputText id="email"
                                       @bind-Value="loginModel.Email" 
                                       placeholder="you@example.com" 
                                       class="w-full px-4 py-3 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Email)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Password field -->
                    <div>
                        <label class="block text-xs font-semibold uppercase tracking-wider text-[#3C322A] mb-2" for="password">
                            Password
                        </label>
                        <div class="relative">
                            <input id="password"
                                   type="@(showPassword ? "text" : "password")" 
                                   @bind="loginModel.Password" 
                                   placeholder="Enter your password" 
                                   class="w-full px-4 py-3 pr-11 rounded-xl bg-white border border-[#E6DACF] text-sm text-[#26201A] placeholder-[#A69B91] focus:outline-none focus:border-[#B84A2B] focus:ring-1 focus:ring-[#B84A2B] transition shadow-sm" />
                            
                            <!-- Show / Hide Password toggle button -->
                            <button type="button" 
                                    @onclick="() => showPassword = !showPassword"
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-[#998A7F] hover:text-[#3C322A] focus:outline-none"
                                    aria-label="Toggle password visibility">
                                @if (showPassword)
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                                    </svg>
                                }
                                else
                                {
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                    </svg>
                                }
                            </button>
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" class="text-xs text-red-600 mt-1 font-medium" />
                    </div>

                    <!-- Remember me & Forgot Password -->
                    <div class="flex items-center justify-between text-xs pt-1">
                        <label class="inline-flex items-center space-x-2.5 text-[#5F5247] cursor-pointer select-none">
                            <InputCheckbox @bind-Value="loginModel.RememberMe" 
                                           class="w-4 h-4 rounded border-[#D2C3B5] text-[#B84A2B] focus:ring-[#B84A2B] focus:ring-offset-0 transition" />
                            <span>Remember me</span>
                        </label>

                        <a href="/forgot-password" class="font-medium text-[#B84A2B] hover:text-[#9A381C] transition-colors">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Submit Button -->
                    <button type="submit" 
                            disabled="@isLoading"
                            class="group relative w-full flex items-center justify-center space-x-2 py-3.5 px-6 rounded-xl bg-[#B84A2B] hover:bg-[#A13E22] active:bg-[#8D351C] text-white font-medium text-sm transition-all shadow-md hover:shadow-lg disabled:opacity-75 disabled:cursor-not-allowed">
                        @if (isLoading)
                        {
                            <svg class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" fill="none" viewBox="0 0 24 24">
                                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                            </svg>
                            <span>Checking ovens...</span>
                        }
                        else
                        {
                            <span>Log in</span>
                            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                            </svg>
                        }
                    </button>
                </div>
            </EditForm>

            <!-- Register link -->
            <div class="mt-6 text-center text-xs text-[#6F6156]">
                New to the empire? 
                <a href="/register" class="font-semibold text-[#B84A2B] hover:text-[#9A381C] transition-colors ml-1">
                    Create an account
                </a>
            </div>

            <!-- Cebu Delivery Info Card -->
            <div class="mt-8 flex items-center space-x-3.5 p-4 rounded-xl bg-[#EBF2EA] border border-[#D7E4D5] text-[#2D452B]">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#DCEADB] flex items-center justify-center text-[#2E582A]">
                    <!-- Motorcycle / Delivery SVG -->
                    <svg class="w-4 h-4 fill-none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <circle cx="5.5" cy="17.5" r="3.5" />
                        <circle cx="18.5" cy="17.5" r="3.5" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 6h4l2 4-3 1-3.5-3.5M6 17.5l4-7.5h5l-2 5h-4" />
                    </svg>
                </div>
                <div class="text-xs leading-snug">
                    <p class="font-bold text-[#1E3A1C]">A little closer to home.</p>
                    <p class="text-[#3E5C3B]">Fresh delivery within Cebu City, Philippines.</p>
                </div>
            </div>
        </main>

        <!-- Footer -->
        <footer class="text-center text-[11px] text-[#A29488]">
            © 2026 Empanada Empire · Made with love in Cebu
        </footer>
    </div>
</div>

@code {
    [SupplyParameterFromForm]
    private LoginModel loginModel { get; set; } = new();

    private bool showPassword = false;
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        isLoading = true;

        // Simulate authentication API call
        await Task.Delay(1000);

        isLoading = false;

        // Navigate to menu catalog upon success
        Nav.NavigateTo("/menu");
    }
}